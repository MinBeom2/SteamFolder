# ==============================================================================
# SteamFolder Local Secret Configuration Template
# ==============================================================================
# 사용 방법:
# 이 파일을 복사하여 같은 디렉토리에 'application-secret.properties' 로 저장하고
# 본인의 로컬 개발 환경에 맞게 값을 입력하세요. (Git에 커밋되지 않습니다)
# ==============================================================================

# 1. Local MySQL Configuration
# 로컬 MySQL 계정 및 비밀번호 설정 (비밀번호가 있는 경우 입력)
spring.datasource.username=root
spring.datasource.password=YOUR_LOCAL_MYSQL_PASSWORD_HERE

# 2. JWT Configuration
# Base64 인코딩된 512-bit HS512 비밀키
jwt.secret=YOUR_BASE64_ENCODED_512BIT_SECRET_KEY_HERE

# 3. Steam Web API Key (추후 스팀 연동 시 필요)
steam.api.key=YOUR_STEAM_WEB_API_KEY_HERE

# 4. Discord Monitoring Webhook (선택)
# 실제 Webhook URL은 이 예시 파일이나 Git에 커밋하지 않습니다.
monitoring.discord.enabled=false
monitoring.discord.webhook-url=YOUR_DISCORD_WEBHOOK_URL_HERE
monitoring.discord.environment=local

# 5. OpenAI Feedback Analysis (선택)
# 이 예시 파일이나 Git에는 실제 API 키를 기록하지 않습니다.
feedback.analysis.enabled=false
feedback.analysis.openai-api-key=YOUR_OPENAI_API_KEY_HERE
feedback.analysis.openai-model=gpt-6-luna
# 일반 피드백(P1/P2) 일일 Discord 요약 시각 (기본: 매일 오전 9시)
feedback.analysis.daily-summary-cron=0 0 9 * * *
feedback.analysis.daily-summary-zone=Asia/Seoul

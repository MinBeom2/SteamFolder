# ==============================================================================
# SteamFolder Local Secret Configuration Template
# ==============================================================================
# 사용 방법:
# 이 파일을 복사하여 같은 디렉토리에 'application-secret.properties' 로 저장하고
# 본인의 로컬 개발용 시크릿 값을 채워넣으세요. (Git에 커밋되지 않습니다)
# ==============================================================================

# 1. JWT Configuration
# Base64 인코딩된 512-bit HS512 비밀키 (본인의 비밀키 문자열을 입력하세요)
JWT_SECRET=YOUR_BASE64_ENCODED_512BIT_SECRET_KEY_HERE

# 2. Steam Web API Key (추후 스팀 연동 시 필요)
STEAM_API_KEY=YOUR_STEAM_WEB_API_KEY_HERE
